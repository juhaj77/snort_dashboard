[Unit]
Description=Forward the Windows capture (dumpcap.exe) to snort0 (snort_dashboard)
Requires=snort0-iface.service
After=snort0-iface.service
Before=snort.service

[Service]
Type=simple
# Optional overrides (WIN_IFACE, CAPTURE_FILTER, DUMPCAP), one VAR=value per line.
EnvironmentFile=-/etc/default/snort-forward
WorkingDirectory=/
ExecStart=/usr/local/bin/snort-forward.sh
# The script loops forever; if it still exits (e.g. killed), start it again.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
